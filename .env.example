# StatusPop Environment Configuration
# Supported Free AI APIs & Production Environment Settings

# 1. GOOGLE GEMINI FREE TIER (1,500 daily requests, no credit card required)
# Used for AI Vision multimodal product auto-detection, copy generation & Nigerian greetings.
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. GROQ CLOUD FREE TIER (14,400 daily requests, ~250ms ultra-low latency)
# Runs Llama 3.3 70B & Llama 3.1 8B for lightning-fast Pidgin & English marketing copy.
# Get free key from: https://console.groq.com/
GROQ_API_KEY=""

# 3. OPENROUTER FREE TIER (Free access to open-source LLMs like Llama 3.3 & DeepSeek)
# Optional fallback for copy generation.
# Get free key from: https://openrouter.ai/
OPENROUTER_API_KEY=""

# 4. HUGGING FACE FREE INFERENCE API (Free Serverless API)
# Optional fallback for RMBG-1.4 background removal and BLIP vision captioning.
# Get free key from: https://huggingface.co/settings/tokens
HF_TOKEN=""

# 5. APP HOSTING CONFIGURATION
# Set APP_URL to the public HTTPS deployment URL in production.
APP_URL="https://statuspop.ng"
PORT="3000"
BETTER_AUTH_URL="http://localhost:3000"

# 6. REFERRAL WATERMARK DOMAIN
REFERRAL_BASE="https://statuspop.ng/r"

# 7. AUTHENTICATION AND EMAIL
# Keep secrets in the host's environment settings, never in source control.
BETTER_AUTH_SECRET=""
RESEND_API_KEY=""
# Use a sender address on a domain verified in Resend.
RESEND_FROM_EMAIL="StatusPop <noreply@accounts.statuspop.ng>"

# 8. CLOUDINARY IMAGE AND FLYER STORAGE
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 9. PAYSTACK
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Optional override for webhook signature verification; defaults to PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=""

# 10. NEON / POSTGRESQL
# Use the Neon pooled connection string for serverless deployment.
DATABASE_URL=""
DATABASE_SSL="true"
DATABASE_POOL_MAX="3"

# 11. ADMIN AUTHENTICATION
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_PASSWORD=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
