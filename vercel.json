{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__statuspopPath=/api/:path*"
    },
    {
      "source": "/r/:path*",
      "destination": "/api?__statuspopPath=/r/:path*"
    },
    {
      "source": "/((?!api/|r/).*)",
      "destination": "/index.html"
    }
  ]
}
